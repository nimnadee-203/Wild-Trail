rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManager() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['manager', 'admin'];
    }

    // Temporary read access while manager authentication is being implemented.
    // Remove this allowlist when manager/admin custom claims are available.
    function isTemporaryManagerReader() {
      return request.auth != null
        && request.auth.uid == 'c665o5t5agSBmye3c6XAB7StEXG2';
    }

    match /incidents/{incidentId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.location.latitude is number
        && request.resource.data.location.longitude is number;

      allow read: if isTemporaryManagerReader() || isManager()
        || (request.auth != null && resource.data.reporterId == request.auth.uid);

      allow update: if request.auth != null
        && resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId == resource.data.reporterId;

      allow delete: if false;
    }
  }
}
