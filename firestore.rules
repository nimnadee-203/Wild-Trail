rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function staffRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', '') == 'ACTIVE'
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') : '';
    }

    function isManager() {
      return request.auth != null
        && (request.auth.token.get('role', '') in ['manager', 'admin']
          || staffRole() in ['manager', 'admin']);
    }

    function isResponder() {
      return request.auth != null
        && (request.auth.token.get('role', '') in ['ranger', 'liaison', 'manager', 'admin']
          || staffRole() in ['ranger', 'liaison', 'manager', 'admin']);
    }

    // Temporary read access while manager authentication is being implemented.
    // Remove this allowlist when manager/admin custom claims are available.
    function isTemporaryManagerReader() {
      return request.auth != null
        && request.auth.uid == 'c665o5t5agSBmye3c6XAB7StEXG2';
    }

    match /incidents/{incidentId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && ((request.resource.data.get('reporterType', '') != 'community'
            && request.resource.data.location.latitude is number
            && request.resource.data.location.longitude is number)
          || (request.resource.data.get('reporterType', '') == 'community'
            && request.resource.data.kind in ['elephant_sighting', 'crop_raiding', 'livestock_attack', 'property_damage', 'human_injury', 'other_wildlife_conflict']
            && request.resource.data.source in ['community_app', 'sms_simulated']
            && (request.resource.data.source == 'community_app' || isResponder())
            && request.resource.data.village is string && request.resource.data.village.size() > 0
            && request.resource.data.boundarySection is string && request.resource.data.boundarySection.size() > 0
            && request.resource.data.landmark is string && request.resource.data.landmark.size() > 0
            && request.resource.data.occurredAt is string
            && request.resource.data.contactPhone is string
            && request.resource.data.photoUris == []
            && request.resource.data.assignedTo == '' && request.resource.data.responseNotes == ''
            && request.resource.data.receivedAt == request.time));

      allow read: if isTemporaryManagerReader() || isManager()
        || (resource.data.get('reporterType', '') == 'community' && isResponder())
        || (request.auth != null && resource.data.reporterId == request.auth.uid);

      // A queue transaction must be able to check whether its new ID exists.
      allow get: if request.auth != null
        && !exists(/databases/$(database)/documents/incidents/$(incidentId));

      allow update: if (request.auth != null
        && resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterId == resource.data.reporterId
        && (resource.data.get('reporterType', '') != 'community'
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUris', 'updatedAt'])))
        || (isResponder() && resource.data.get('reporterType', '') == 'community'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responseNotes', 'updatedAt'])
          && request.resource.data.status in ['pending', 'investigating', 'resolved', 'dismissed']
          && request.resource.data.assignedTo is string
          && request.resource.data.responseNotes is string)
        || (request.auth != null && resource.data.get('reporterType', '') == 'community'
          && (staffRole() in ['ranger', 'liaison'] || request.auth.token.get('role', '') in ['ranger', 'liaison'])
          && resource.data.assignedTo == '' && resource.data.status == 'pending'
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.assignedName is string
          && request.resource.data.status == 'investigating'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedTo', 'assignedName', 'status', 'updatedAt']));

      allow delete: if false;
    }

    // Staff roles are provisioned through trusted administration, not by reporters.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isManager());
      allow write: if request.auth != null
        && (request.auth.token.get('role', '') == 'admin' || staffRole() == 'admin');
    }
  }
}
